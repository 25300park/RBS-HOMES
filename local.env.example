# 로컬 개발 전용 템플릿. 전부 가짜 값이다. 실제 사용 시:
#   cp local.env.example .env.local
# .env.local은 .gitignore에 의해 git 추적 대상이 아니다.

DATABASE_URL="mysql://root:localpass@localhost:3307/rbs_local"

NEXTAUTH_SECRET="local-fake-secret-not-for-production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 로컬에서는 절대 실제 메일을 보내지 않는다.
EMAIL_MODE="off"
RESEND_API_KEY="local-fake-resend-key"

GOOGLE_CLIENT_ID="local-fake-google-client-id"
GOOGLE_CLIENT_SECRET="local-fake-google-client-secret"
GOOGLE_PLACE_ID="local-fake-place-id"
GOOGLE_MAPS_URL="http://example.invalid"
NEXT_PUBLIC_GOOGLE_KEY="local-fake-google-maps-key"

R2_ENDPOINT="https://local-fake.r2.cloudflarestorage.com"
R2_BUCKET_NAME="local-fake-bucket"
R2_PUBLIC_URL="https://local-fake-images.invalid"
R2_ACCESS_KEY_ID="local-fake-r2-access-key"
R2_SECRET_ACCESS_KEY="local-fake-r2-secret-key"

RBS_SYNC_SECRET="local-fake-sync-secret"
CRM_SYNC_SECRET="local-fake-crm-sync-secret"
CRM_ADMIN_ID="1"

ANTHROPIC_API_KEY="local-fake-anthropic-key"
